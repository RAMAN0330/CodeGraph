GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback
SESSION_SECRET=a_long_random_string_min_32_chars
CLIENT_ORIGIN=http://localhost:5173
PORT=5000
NODE_ENV=development
FASTAPI_URL=http://localhost:8000
LEGACY_API_URL=http://localhost:5001
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DB_CREDENTIALS_SECRET=another_long_random_string_min_32_chars
# Proxy hops in front of the Node API (2 behind nginx + Go gateway).
TRUST_PROXY_HOPS=1
# Optional: automatic PR reviews via a GitHub App (Settings → Developer settings
# → GitHub Apps). Permissions: Pull requests read, Contents read, Checks write,
# Issues write. Subscribe to "Pull request" events and point the webhook at
# <public URL>/api/github/webhook with the secret below.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Minutes between checks that re-analyze project repositories whose default
# branch moved (drives regression alerts). 0 disables. Default 360.
ANALYSIS_SCHEDULE_MINUTES=360
# Weekly digest to project alert webhooks, as a cron in UTC ("off" disables).
DIGEST_CRON=0 9 * * 1
